# Backend Environment Variables
# Copy this file to .env and fill in real values

# Server
PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# RailCore API (primary chart vacancy provider)
# Register at: https://railcore.tech
RAILCORE_API_KEY=your_railcore_api_key
RAILCORE_BASE_URL=https://ir.railcore.tech/v1
RAILCORE_TIMEOUT_MS=10000
RAILCORE_MAX_RETRIES=2

# RailKit API (train search supplement - optional)
# Register at: https://railkit.in
RAILKIT_API_KEY=your_railkit_api_key

# Provider selection
# Options: "mock" | "railcore" | "railkit"
CHART_PROVIDER=mock

# Cache
CACHE_TTL_SECONDS=300
STALE_TTL_SECONDS=900

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS - comma separated origins
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
