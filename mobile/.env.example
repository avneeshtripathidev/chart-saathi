# Mobile App Environment Variables (Expo)
# In production, configure these via EAS Secrets or your hosting platform

# Supabase Auth & Database (Public Anon Key only - Never use service role on client)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ChartSaathi Backend API
EXPO_PUBLIC_API_URL=http://localhost:3000
